# ==============================================================================
# NovaPulse AI Environment Configuration Template
# Copy this file to .env.local and configure your personal credentials.
# NEVER commit .env.local to GitHub.
# ==============================================================================

# Client-Safe Environment Variables (Bundled by Vite into browser code)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_RAZORPAY_PAYMENT_LINK=https://razorpay.me/@sanjai6676

# Server-Side Only Secrets (NEVER prefix these with VITE_ and NEVER expose to client)
# Used by Vercel Serverless Functions (/api/razorpay/...)
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Supabase Service Role Key (Used strictly server-side for admin verification)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
